
# These are generated by running `npm install` and can be very large.Which should not be git pushed
/node_modules/
/backend/node_modules/
/frontend/node_modules/

# This file contains secrets and should NEVER be committed to Git.
.env
.env.*
!.env.example

# These are the build output which should not be stored.
# Log files are specific to a user's machine and environment.
logs
*.log
# npm file which is created when the error has happened or any debug has occured.
npm-debug.log* 
# pnpm file which is created when the error has happened or any debug has occured.
pnpm-debug.log*

# Operating System generated files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Compiled files and executables
# These are generated from source code and shouldn't be tracked.
*.exe
